{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "live-view-template.v1",
  "title": "screenpipe Live View Template v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "revision",
    "blocks",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schema": {
      "const": "live-view-template.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "blocks": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "width", "order"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "enum": [
            "metric.v1",
            "list.v1",
            "bar-chart.v1",
            "timeline.v1",
            "markdown.v1"
          ]
        },
        "width": {
          "enum": [3, 6, 12]
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "binding": {
          "$ref": "#/$defs/binding"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipeName"],
      "properties": {
        "pipeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    }
  }
}
